==========================================
DAY 19 — SSH KEY-BASED AUTHENTICATION
Commands Reference Sheet
Machine: Kali Linux | User: raven
==========================================

--- GENERATING AN SSH KEY PAIR ---
ssh-keygen -t ed25519 -C "your_email@example.com"    # generate a modern key pair
ssh-keygen -t rsa -b 4096 -C "your_email@example.com" # older alternative (RSA, 4096-bit)

--- FILES CREATED ---
~/.ssh/id_ed25519       # PRIVATE key — NEVER share this, permissions must be 600
~/.ssh/id_ed25519.pub   # PUBLIC key — safe to share, this goes to servers

--- CHECKING/FIXING KEY PERMISSIONS ---
ls -la ~/.ssh                        # check current permissions
chmod 700 ~/.ssh                      # correct permission for the .ssh folder
chmod 600 ~/.ssh/id_ed25519           # correct permission for PRIVATE key
chmod 644 ~/.ssh/id_ed25519.pub       # correct permission for PUBLIC key

--- COPYING YOUR PUBLIC KEY TO A SERVER ---
ssh-copy-id user@host                            # easiest way, does everything automatically
ssh-copy-id -i ~/.ssh/id_ed25519.pub user@host   # specify exact key if you have multiple

--- MANUAL METHOD (if ssh-copy-id unavailable) ---
cat ~/.ssh/id_ed25519.pub | ssh user@host "mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys"
ssh user@host "chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys"

--- VIEWING KEY CONTENTS ---
cat ~/.ssh/id_ed25519.pub             # view your public key (safe to display/share)
cat ~/.ssh/authorized_keys            # (on remote server) view keys that are trusted

--- TESTING PASSWORDLESS LOGIN ---
ssh user@host                          # should now log in WITHOUT asking for a password

