--- MANAGING YOUR CRONTAB ---
crontab -e                       # edit your personal crontab (opens an editor)
crontab -l                        # list your current cron jobs
crontab -r                        # REMOVE all your cron jobs (no confirmation, be careful!)

--- CRON SYNTAX (5 fields) ---
# minute(0-59) hour(0-23) day-of-month(1-31) month(1-12) day-of-week(0-7, 0/7=Sunday)
* * * * * command_to_run

--- SPECIAL CHARACTERS ---
*     # every (any value)
,     # list, e.g. 1,3,5
-     # range, e.g. 1-5 (Mon-Fri)
/     # step, e.g. */5 (every 5 units)

--- COMMON CRON EXAMPLES ---
0 6 * * *          command    # every day at 6:00 AM
*/5 * * * *        command    # every 5 minutes
0 9-17 * * 1-5     command    # every hour, 9AM-5PM, Mon-Fri
0 0 * * 0          command    # every Sunday at midnight
30 23 * * 5        command    # 11:30 PM every Friday
0 6 1 * *          command    # 1st of every month at 6 AM

--- SHORTCUTS (replace the 5-field syntax) ---
@reboot            command    # run once when system starts
@daily             command    # same as: 0 0 * * *
@hourly            command    # same as: 0 * * * *
@weekly            command    # same as: 0 0 * * 0
@monthly           command    # same as: 0 0 1 * *

--- BEST PRACTICES ---
0 2 * * * /full/path/to/script.sh >> /full/path/to/logfile.log 2>&1
   # ALWAYS use full paths + redirect output — avoids silent failures

